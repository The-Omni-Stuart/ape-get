# Something that is not ape-get is sitting where ape-get would go. Setup says
# so before asking, and its question says replace rather than install; an
# unanswered question leaves the foreign program exactly as it was found,
# mode included.
tags=any
env=APEGET_SELF_EXE={home}/portable/ape-get.com
argv=setup
file=.local/bin/ape-get
