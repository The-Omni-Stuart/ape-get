# A plain `setup` on a piped stdin cannot be answered, so it stops before
# touching the disk: the questions are asked, the --yes hint is the last
# word, and the home is untouched. Guards the "ask before you change
# anything" rule that --yes is the release valve for.
tags=any
env=APEGET_SELF_EXE={home}/portable/ape-get.com
argv=setup
file=.local/bin/ape-get
file=.profile
file=.zshrc
file=portable/ape-get.com
