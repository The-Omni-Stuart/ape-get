# Running setup again must not stack a second PATH entry: the home already
# carries an entry from an earlier install, to a directory the command has
# since moved out of, sitting between the user's own lines. The old entry is
# replaced, the user's lines keep their order, and the result is one line.
tags=any
env=APEGET_SELF_EXE={home}/portable/ape-get.com
argv=setup
argv=--yes
file=.local/bin/ape-get
file=.profile
