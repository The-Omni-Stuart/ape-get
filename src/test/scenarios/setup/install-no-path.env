# The install itself: --yes answers the confirmation, --no-path keeps PATH
# out of it, and the portable executable lands in the platform default
# directory under the name its command answers to, executable for the user.
tags=any
env=APEGET_SELF_EXE={home}/portable/ape-get.com
argv=setup
argv=--yes
argv=--no-path
file=.local/bin/ape-get
file=.local/bin/ape-get.com
file=.profile
file=.zshrc
file=portable/ape-get.com
