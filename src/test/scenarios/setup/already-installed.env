# A repeated setup must say so rather than redo work: the file already in
# place is byte-for-byte this executable, and PATH already lists the
# directory. Nothing is rewritten and no question is asked -- --yes stands
# in for the answer the run does not need.
tags=any
env=APEGET_SELF_EXE={home}/portable/ape-get.com
argv=setup
argv=--yes
file=.local/bin/ape-get
file=.profile
