# --dry-run reports the plan for the running platform and changes nothing:
# neither the install root nor a shell init file appears in the home. The
# executable being installed is a fixture, not the 1 MB test binary.
tags=any
env=APEGET_SELF_EXE={home}/portable/ape-get.com
argv=setup
argv=--yes
argv=--dry-run
file=.local/bin/ape-get
file=.profile
file=.zshrc
file=portable/ape-get.com
