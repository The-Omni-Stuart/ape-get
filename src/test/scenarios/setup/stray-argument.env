# A path typed after the command is not a prefix, and ignoring it would
# install somewhere the user did not ask for. The name is refused before
# anything is asked or written, with the flag that does the job named back.
tags=any
env=APEGET_SELF_EXE={home}/portable/ape-get.com
argv=setup
argv=/tmp/somewhere
file=.local/bin/ape-get
file=.profile
