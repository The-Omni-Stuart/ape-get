# The default asks about PATH and yes is the answer: --yes stands in for
# that answer on a piped stdin, so the run registers the install directory
# for future shells in the file a login shell reads.
tags=any
env=APEGET_SELF_EXE={home}/portable/ape-get.com
argv=setup
argv=--yes
file=.local/bin/ape-get
file=.profile
file=.zshrc
