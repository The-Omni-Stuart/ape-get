# --prefix moves both halves of the install: the command lands in the
# directory named, and PATH is offered for that directory rather than the
# platform default the plan would otherwise have shown.
tags=any
env=APEGET_SELF_EXE={home}/portable/ape-get.com
argv=setup
argv=--yes
argv=--prefix
argv={home}/opt/ape-get
file=opt/ape-get/ape-get
file=.local/bin/ape-get
file=.profile
