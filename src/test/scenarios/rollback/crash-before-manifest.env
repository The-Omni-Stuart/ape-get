tags=any
# crash after the committing journal, before the staged renames
env=APEGET_TEST_CRASH=rollback
argv=-y
argv=rollback
argv=forge:owner/tool
file=.local/share/github-release-manager/applications/forge/owner__tool/grm_manifest.json
file=.local/share/github-release-manager/applications/forge/owner__tool/grm_manifest.json.tmp-*
file=.local/bin/tool
file=.local/bin/tool.tmp-*
file=.local/share/github-release-manager/grm_transaction.json
