# a foreign file in the install root is not touched by an ordinary command:
# with registration retired there is nothing that even tries to replace it,
# so the run is silent and the file survives byte-for-byte
tags=any
env=APEGET_NO_SELF=
file=.local/share/github-release-manager/applications/self
file=.local/bin/ape-get
argv=providers
argv=add
argv=forge
argv=https://forge.example
argv=--type
argv=gitea
