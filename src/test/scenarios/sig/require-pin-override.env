tags=any
mock=1
# P12: required-signature is an independent policy — --allow-signer-change
# (auto-confirmed by --yes) accepts a different verified signer, never the
# missing signature of the 1.1.0 release
env=PATH={home}/bin:/usr/bin:/bin
argv=-y
argv=--require-signature
argv=--allow-signer-change
argv=update
argv=mock:owner/tool
