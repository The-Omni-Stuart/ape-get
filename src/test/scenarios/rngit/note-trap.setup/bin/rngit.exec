#!/bin/sh
echo "$*" >> "$HOME/rngit-calls.log"
[ "$1 $3" = "release view" ] || exit 1
[ "$4" = latest ] || exit 1
printf '\033[1mRelease :\033[0m 1.4.2\n'
printf '  \033[36mArtifacts (\033[0m3):\n'
printf '  - \033[32mapp-1.4.2.AppImage\033[0m (2 KiB)\n'
printf '  - manifest.rsm (1 KiB)\n'
printf '  - release.rsg (1 KiB)\n'
printf 'Release notes:\n'
printf 'Built with love over winter.\n'
printf '  - Shipped with a trap line\n'
exit 0
