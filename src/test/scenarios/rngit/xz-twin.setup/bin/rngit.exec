#!/bin/sh
echo "$*" >> "$HOME/rngit-calls.log"
if [ "$1 $3" = "release view" ] && [ "$4" = latest ]; then
  printf 'Release : v1.0.0\n'
  printf 'Artifacts (2):\n'
  printf '  - app-1.0.0.ape (1 KiB)\n'
  printf '  - app-1.0.0.ape.xz (1 KiB)\n'
  exit 0
fi
if [ "$1 $3" = "release fetch" ]; then
  name=$(printf "%s" "$4" | cut -d: -f2)
  cp "$HOME/fixtures/$name" "$PWD/$name" || exit 1
  exit 0
fi
exit 1
