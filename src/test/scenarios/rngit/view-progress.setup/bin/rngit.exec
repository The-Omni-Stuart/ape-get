#!/bin/sh
echo "$*" >> "$HOME/rngit-calls.log"
if [ "$1 $3" = "release view" ] && [ "$4" = latest ]; then
  printf 'Requesting path...\rPath resolved\rLink established\r                    \rRelease : 1.0.0\n'
  printf 'Status  : published\n'
  printf 'Created : 2026-11-02 23:44:08\n\n'
  printf 'Artifacts (2)\n=============\n'
  printf ' - tool-1.0.0.ape (21 B)\n'
  printf ' - tool-1.0.0.ape.xz (112 B)\n'
  exit 0
fi
exit 1
