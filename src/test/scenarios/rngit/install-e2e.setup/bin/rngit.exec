#!/bin/sh
echo "$*" >> "$HOME/rngit-calls.log"
if [ "$1 $3" = "release view" ] && [ "$4" = latest ]; then
  printf 'Release : 1.0.0\n'
  printf 'Artifacts (3):\n'
  printf '  - app-1.0.0.AppImage (2 KiB)\n'
  printf '  - manifest.rsm (1 KiB)\n'
  printf '  - release.rsg (1 KiB)\n'
  exit 0
fi
if [ "$1 $3" = "release fetch" ] && [ "$4" = "1.0.0:app-1.0.0.AppImage" ]; then
  printf 'FAKE-APPIMAGE-PAYLOAD\n' > "$PWD/app-1.0.0.AppImage"
  exit 0
fi
exit 1
